# Escalation service (npm run server). Copy to .env and fill in what you have.
# With nothing filled in, the service runs a dry run: calls are acted out on screen.

ESCALATION_PORT=8787
# Public HTTPS address that reaches this service (for Twilio and Meta webhooks), e.g. an ngrok or cloudflared URL.
PUBLIC_URL=

# Who gets called (E.164). The demo's shift leads are fictional; put real phones here.
CONTACT_NIGHT_LEAD=
CONTACT_DAY_LEAD=
CONTACT_BACKUP=

# Twilio: phone calls (Programmable Voice) and WhatsApp calls (WhatsApp Business Calling)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=
# Your WhatsApp sender with Voice Configuration set, e.g. whatsapp:+9715XXXXXXXX
TWILIO_WHATSAPP_FROM=

# Meta WhatsApp Cloud API: messages with Approve / Reject / Call me buttons
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Voice
TTS_VOICE=Polly.Amy-Neural
TTS_LANGUAGE=en-GB
RING_SECONDS=25
VALIDATE_SIGNATURES=true
